{
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react-jsx"
  },
  "include": ["packages/*/src/**/*", "packages/*/test/**/*", "e2e/**/*"],
  "exclude": ["packages/web"] // web 有独立 tsconfig（含 DOM lib），用 pnpm --filter @mcp-manager/web typecheck
}
